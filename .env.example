# =============================================================================
# Car Dealership Management — Environment Variables Template
# =============================================================================
# Copy: cp .env.example .env
# Docker Compose can run without this file by using local demonstration defaults.
# Replace every placeholder before exposing the application outside your machine.
# Manual local development uses H2; Docker always activates the prod/PostgreSQL profile.
# =============================================================================

# ── Spring Profile (local or prod) ───────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local

# ── JWT [REQUIRED] - generate with: openssl rand -base64 64 ──────────────────
JWT_SECRET=change-me-to-a-real-base64-secret
JWT_EXPIRATION_MS=86400000

# ── SITE_ADMIN Bootstrap (first-run only) [REQUIRED] ─────────────────────────
SITE_ADMIN_EMAIL=admin@dealership.local
SITE_ADMIN_PASSWORD=change-me-admin-password

# ── Local H2 Demo Accounts (optional; ignored by prod) ───────────────────────
DEMO_DATA_PASSWORD=Demo123!

# ── Postgres Container (Docker Compose only) ─────────────────────────────
# Compose maps these values to Spring's production datasource variables.
# Keeping SPRING_DATASOURCE_* out of this file prevents local H2 overrides.
POSTGRES_USER=cars
POSTGRES_PASSWORD=change-me-database-password
POSTGRES_DB=carsdb
