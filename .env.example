# =============================================================================
# Car Dealership Management — Environment Variables Template
# =============================================================================
# Copy: cp .env.example .env
# Then fill in real values (especially JWT_SECRET and SITE_ADMIN_PASSWORD).
# Local dev uses H2 by default; prod/Docker needs every variable set.
# =============================================================================

# ── Spring Profile (local or prod) ───────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local

# ── JWT [REQUIRED] - generate with: openssl rand -base64 64 ──────────────────
JWT_SECRET=change-me-to-a-real-base64-secret
JWT_EXPIRATION_MS=86400000

# ── SITE_ADMIN Bootstrap (first-run only) [REQUIRED] ─────────────────────────
SITE_ADMIN_EMAIL=admin@dealership.local
SITE_ADMIN_PASSWORD=change-me-admin-password

# ── Database (only used with prod profile or Docker Compose) ─────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/carsdb
SPRING_DATASOURCE_USERNAME=cars
SPRING_DATASOURCE_PASSWORD=localdev

# ── Postgres Container (Docker Compose) - must match above ───────────────────
POSTGRES_USER=cars
POSTGRES_PASSWORD=localdev
POSTGRES_DB=carsdb
