# Car Dealership Management - Environment Variables
# Copy: cp .env.example .env
# Local dev uses H2 by default; prod/Docker needs every [REQUIRED-PROD] var.

# JWT [REQUIRED-PROD] - generate with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-real-base64-secret
JWT_EXPIRATION_MS=86400000

# Postgres (only for prod profile or Docker Compose)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/carsdb
SPRING_DATASOURCE_USERNAME=cars
SPRING_DATASOURCE_PASSWORD=localdev

# Postgres container (Docker Compose) - must match above
POSTGRES_USER=cars
POSTGRES_PASSWORD=localdev
POSTGRES_DB=carsdb

# SITE_ADMIN bootstrap [REQUIRED]
SITE_ADMIN_EMAIL=admin@dealership.local
SITE_ADMIN_PASSWORD=change-me-admin-password
