# Demo environment variables for local development.
# These are insecure demo defaults suitable for a portfolio/demo project only.
# In production, generate a real JWT secret and use strong, unique passwords.
#
# Copy this file to .env and override any values you need:
#   cp .env.example .env
#
# NOTE: Docker Compose automatically loads .env at the project root. The
# variables below are meant for native development (IDE, mvn spring-boot:run).
# compose.yaml hard-codes its own internal database URL, so these values do not
# affect the Docker Compose database connection.

# ---------------------------------------------------------------------------
# JWT Configuration
# Generate a strong secret with: openssl rand -base64 64
# ---------------------------------------------------------------------------
JWT_SECRET=lLkWl475AXcZRZukLjUfcVX/BOPOqnkIxXY3LOHC9VmwDcH3lqno3uRbzegqhn8T4crRwlgMEVCkLr+b1B3hXQ==
# Default is 24 hours (86400000 ms). Override only if you need a different lifetime.
JWT_EXPIRATION_MS=86400000

# ---------------------------------------------------------------------------
# PostgreSQL connection (used by app services; local dev uses fallbacks)
# Use 'localhost' when running the app natively (IDE, mvn spring-boot:run, etc.)
# Use 'database' when running the app via Docker Compose (the Postgres service name)
# ---------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/carsdb
SPRING_DATASOURCE_USERNAME=cars
SPRING_DATASOURCE_PASSWORD=localdev

# ---------------------------------------------------------------------------
# PostgreSQL container (used by the database service in compose.yaml)
# These must match the SPRING_DATASOURCE_* values above.
# ---------------------------------------------------------------------------
POSTGRES_USER=cars
POSTGRES_PASSWORD=localdev
POSTGRES_DB=carsdb
